<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for hosting the GrubMarket redesign on an internal server.
  Drop this in the site root. It replicates what vercel.json does, and adds the
  authentication that Vercel handled outside the project.
-->
<configuration>
  <system.webServer>

    <!-- webp and woff2 are not in IIS's default MIME map on older installs.
         Without these the images and brand fonts silently fail to load. -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- Keep this while the site holds placeholder investor content. -->
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <!-- Scoped to what the site actually loads. 'unsafe-inline' is required
             for style-src only: 67 inline style attributes depend on it. -->
        <add name="Content-Security-Policy"
             value="default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <rule name="awards-html" stopProcessing="true">
          <match url="^awards\.html$" />
          <action type="Redirect" url="/recognition.html" redirectType="Permanent" />
        </rule>
        <rule name="awards" stopProcessing="true">
          <match url="^awards/?$" />
          <action type="Redirect" url="/recognition.html" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>

  <!--
    AUTHENTICATION.
    Enable Windows Authentication and disable Anonymous in IIS Manager for this
    site, or uncomment below. This is the right layer for a static site: every
    request is checked, including someone requesting investors.html directly,
    and access follows domain accounts rather than a shared password.

    Do NOT attempt to gate this site with JavaScript. The files are static;
    a client-side login can be bypassed by viewing source or requesting a
    file directly.
  -->
  <!--
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>
  -->

</configuration>
